# Copy to `.env` and fill in. NEVER commit `.env` (it is git-ignored).
#
# ---------------------------------------------------------------------------
# THE SYSTEM RUNS COMPLETELY WITHOUT ANY CREDENTIALS.
# Learning, storage, retrieval, context gating, correction, explanation,
# update, delete, reset and the ENTIRE evaluation work with no key at all.
# The key below only enables the OPTIONAL LLM adjudicator + prompt-injection
# formatting mode, which are reported as a separate, measured comparison.
# ---------------------------------------------------------------------------

# Optional. Sarvam AI API key, format sk_xxx. Get one at https://dashboard.sarvam.ai
SARVAM_API_KEY=

# Optional overrides (defaults shown).
KIVI_LLM_MODEL=sarvam-105b
KIVI_LLM_BASE_URL=https://api.sarvam.ai/v1
KIVI_LLM_TIMEOUT_S=20

# Where the SQLite database file lives.
KIVI_DB_PATH=./kivi.db

# Application mode for producing memory-aware output:
#   deterministic = span replacement, no model calls, always available (default)
#   prompt        = retrieved memories are placed into the formatting prompt (needs SARVAM_API_KEY)
KIVI_APPLY_MODE=deterministic

# Set to 1 to let the optional LLM adjudicate spans that fall in the uncertain band.
# Requires SARVAM_API_KEY. Off by default so default behaviour is fully reproducible.
KIVI_USE_LLM_ADJUDICATOR=0
